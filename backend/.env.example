ENVIRONMENT=development
DATABASE_URL=DATABASE_URL
REDIS_URL=redis://redis:xxx/x
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost
GOOGLE_SHEETS_ENABLED=true
GITHUB_TOKEN=your_github_token_here

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Copy to backend/.env. NEVER commit backend/.env.
ENVIRONMENT=development

# These host names (db, redis) are Docker Compose service names.
# Running outside Docker? Use localhost instead.
# The password must match POSTGRES_PASSWORD in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://careeruser:change-me@db:5432/careerdb
REDIS_URL=redis://redis:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost

GOOGLE_SHEETS_ENABLED=true
# --- Agent: LLM provider chain ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
OPENROUTER_API_KEY=
LLM_PRIMARY_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_MODEL=gemini-flash-latest

# --- Agent: BYOK encryption ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-fernet-key

# --- Agent: Crustdata ---
CRUSTDATA_API_KEY=your_crustdata_api_key_here

# --- Agent: runtime limits ---
AGENT_MAX_STEPS=8
AGENT_CREDIT_BUDGET=50.0
AGENT_DRY_RUN_DEFAULT=true