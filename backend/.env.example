ENVIRONMENT=development
DATABASE_URL=DATABASE_URL
REDIS_URL=redis://redis:xxx/x
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost
GOOGLE_SHEETS_ENABLED=true
GITHUB_TOKEN=your_github_token_here

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Copy to backend/.env. NEVER commit backend/.env.
ENVIRONMENT=development

# These host names (db, redis) are Docker Compose service names.
# Running outside Docker? Use localhost instead.
# The password must match POSTGRES_PASSWORD in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://careeruser:change-me@db:5432/careerdb
REDIS_URL=redis://redis:6379/0

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost

GOOGLE_SHEETS_ENABLED=true
# Optional
ANTHROPIC_API_KEY=